# UniPods Memory AI
# Copy to .env and fill in values. Never commit real secrets.

# --- App ---
APP_ENV=development
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:3000
FRONTEND_URL=http://localhost:3000

# --- Database (your local Postgres) ---
DATABASE_URL=postgresql+asyncpg://postgres:your_password_here@localhost:5432/hackathon_db
USE_PGVECTOR=false

# --- LLM providers ---
# NVIDIA NIM / API Catalog (nvapi-…)
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=mistralai/mistral-nemotron

# Optional fallbacks
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# --- WhatsApp (Wassenger preferred) ---
WASSENGER_API_KEY=
WASSENGER_DEVICE_ID=
WASSENGER_PHONE=

# Optional Meta Cloud API fallback
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=your_verify_token_here
WHATSAPP_APP_SECRET=

# --- Microsoft Teams / Azure Bot (stretch) ---
TEAMS_APP_ID=
TEAMS_APP_PASSWORD=
TEAMS_TENANT_ID=

# --- Storage ---
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=50